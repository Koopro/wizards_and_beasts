  "profession.wizards_and_beasts.centaur_ranger": "Ranger",
  "profession.wizards_and_beasts.centaur_ranger.desc": "Archery, trailcraft, and the forest's own sense of trespass.",
  "profession.wizards_and_beasts.centaur_stargazer_path": "Star Reader",
  "profession.wizards_and_beasts.centaur_stargazer_path.desc": "Turns canopy gaps into observatories — reading futures in light older than wands.",
  "profession.wizards_and_beasts.elf_binder": "Ward Binder",
  "profession.wizards_and_beasts.elf_binder.desc": "Weaves household wards into oaths older than any single wand line.",
  "profession.wizards_and_beasts.elf_liberator": "Liberated Adept",
  "profession.wizards_and_beasts.elf_liberator.desc": "A freed elf who has turned binding-magic inward — mastering depths polite wandcraft rarely touches.",
  "profession.wizards_and_beasts.elf_steward": "Steward",
  "profession.wizards_and_beasts.elf_steward.desc": "Keeps hearths whole — mending, shielding, and anticipating need before it is spoken.",
  "profession.wizards_and_beasts.giant_bruiser": "Bruiser",
  "profession.wizards_and_beasts.giant_bruiser.desc": "Raw reach and weight turned into a craft of its own — the simplest kind, and the hardest to parry.",
  "profession.wizards_and_beasts.giant_ravager": "Ravager",
  "profession.wizards_and_beasts.giant_ravager.desc": "Learns to read fear in herds and mobs alike, turning panic into advantage.",
  "profession.wizards_and_beasts.giant_warlord": "Warlord",
  "profession.wizards_and_beasts.giant_warlord.desc": "Commands broken ground and broken ranks with a shout that needs no translation.",
  "profession.wizards_and_beasts.goblin_banker": "Bank Steward",
  "profession.wizards_and_beasts.goblin_banker.desc": "Oversees vault rotations, curse-breaker contracts, and the politics of who may withdraw what.",
  "profession.wizards_and_beasts.goblin_clerk": "Vault Clerk",
  "profession.wizards_and_beasts.goblin_clerk.desc": "Ledgers, liens, and the patient arithmetic that keeps a dragon from boredom.",
  "profession.wizards_and_beasts.goblin_director": "Gringotts Director",
  "profession.wizards_and_beasts.goblin_director.desc": "Commands policy where metal, magic, and Ministry memoranda collide beneath London.",
  "profession.wizards_and_beasts.goblin_metalsmith": "Metalsmith",
  "profession.wizards_and_beasts.goblin_metalsmith.desc": "Forges and refines the enchanted alloys that laugh at ordinary rust.",
  "profession.wizards_and_beasts.merpeople_deepcaller": "Deep Caller",
  "profession.wizards_and_beasts.merpeople_deepcaller.desc": "Song that carries farther through water than any surface horn could dream.",
  "profession.wizards_and_beasts.merpeople_songweaver": "Songweaver",
  "profession.wizards_and_beasts.merpeople_songweaver.desc": "Weaves pressure, melody, and command until the sea itself seems to take sides.",
  "profession.wizards_and_beasts.merpeople_tidewarden": "Tidewarden",
  "profession.wizards_and_beasts.merpeople_tidewarden.desc": "Guards reefs, wrecks, and the old treaties scratched on cave stone.",
  "profession.wizards_and_beasts.obscurial_channeler": "Channeler",
  "profession.wizards_and_beasts.obscurial_channeler.desc": "First tentative reins on a force that would rather consume than obey.",
  "profession.wizards_and_beasts.obscurial_conduit": "Conduit",
  "profession.wizards_and_beasts.obscurial_conduit.desc": "Channels the Obscurus with intent, trading serenity for bursts of annihilating pressure.",
  "profession.wizards_and_beasts.obscurial_harbinger": "Harbinger",
  "profession.wizards_and_beasts.obscurial_harbinger.desc": "Walks the edge where host and parasite blur; cities remember names like this in ash.",
  "profession.wizards_and_beasts.vampire_nightlord": "Nightlord",
  "profession.wizards_and_beasts.vampire_nightlord.desc": "A title earned in bloodlines and battlefields alike — night bends toward them, not away.",
  "profession.wizards_and_beasts.vampire_stalker": "Stalker",
  "profession.wizards_and_beasts.vampire_stalker.desc": "Night-hunter's patience — stillness, scent, and the geometry of ambush.",
  "profession.wizards_and_beasts.vampire_wraith": "Wraith",
  "profession.wizards_and_beasts.vampire_wraith.desc": "Shadow clings where they walk; daylight stories fail to describe what witnesses saw.",
  "profession.wizards_and_beasts.veela_charmer": "Charmer",
  "profession.wizards_and_beasts.veela_charmer.desc": "Refines allure into something almost civilised — until anger strips the mask.",
  "profession.wizards_and_beasts.veela_flame_dancer": "Flame Dancer",
  "profession.wizards_and_beasts.veela_flame_dancer.desc": "Harpy fury married to ballroom grace; fire answers the dance before the wand could.",
  "profession.wizards_and_beasts.veela_songbird": "Songbird",
  "profession.wizards_and_beasts.veela_songbird.desc": "Voice-work that bends attention the way sirens bend tides — beautiful, cruel, precise.",
  "profession.wizards_and_beasts.werewolf_alpha": "Alpha",
  "profession.wizards_and_beasts.werewolf_alpha.desc": "Commands the night with a predator's certainty; lesser wolves answer before they think.",
  "profession.wizards_and_beasts.werewolf_packmaster": "Pack Master",
  "profession.wizards_and_beasts.werewolf_packmaster.desc": "Begins to steer the transformation instead of only surviving it — instinct shaped into strategy.",
  "profession.wizards_and_beasts.werewolf_tracker": "Tracker",
  "profession.wizards_and_beasts.werewolf_tracker.desc": "Heightened senses and fieldcraft learned under moons that do not forgive mistakes.",
